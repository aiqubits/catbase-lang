# test_opus_ffi.cat
# 阶段 4：测试通过 Pointer 与真实 C 库 (libopus) 交互
# 验证：opus 编码 + 解码 全套流程

import "opus/func.catc" as opus
import "/usr/lib/x86_64-linux-gnu/libc.so" as libc
from libc import malloc(size: int) -> Pointer
from libc import free(ptr: Pointer)
from opus import opus_encoder_create(Fs: int, channels: int, application: int, error: Pointer) -> Pointer
from opus import opus_encoder_destroy(encoder: Pointer)
from opus import opus_encode(encoder: Pointer, pcm: bytes, len: int, output: Pointer, max_output_len: int) -> int
from opus import opus_decoder_create(Fs: int, channels: int, error: Pointer) -> Pointer
from opus import opus_decoder_destroy(decoder: Pointer)
from opus import opus_decode(decoder: Pointer, data: bytes, len: int, output: Pointer, frame_size: int, decode_fec: int) -> int

def main(args: list[str]) {
    print("=== Opus FFI 测试 ===\n")

    # 1. 创建错误码（i32 指针）
    err: int = 0
    err_ptr: Pointer = int32_ptr(err)

    # 2. 创建 Opus 编码器（48000Hz, 1 通道, OPUS_APPLICATION_VOIP=2048）
    encoder: Pointer = opus.opus_encoder_create(48000, 1, 2048, err_ptr)
    print("[opus] encoder created, is_null =", encoder.is_null())

    # 3. 创建 Opus 解码器
    decoder: Pointer = opus.opus_decoder_create(48000, 1, err_ptr)
    print("[opus] decoder created, is_null =", decoder.is_null())

    # 4. 准备 PCM 输入数据（i16 数组）
    # 模拟 10ms 音频 @ 48000Hz 帧大小 480 = 960 字节 = 480 个 int16
    # 用静音（全 0）测试
    pcm_len: int = 960
    pcm: bytes = bytes_alloc(pcm_len)  # 960 字节全 0

    # 5. 编码（Pointer 作为输出 buffer）
    output_buf: Pointer = libc.malloc(4000)  # Opus 最大包大小约 4000 字节
    encoded_len: int = opus.opus_encode(encoder, pcm, 480, output_buf, 4000)
    print("[opus] encoded_len =", encoded_len, "字节")

    # 6. 解码（把刚编码的数据解码回 PCM）
    # 需要 encoded_len 长度的数据，但 output_buf 包含的是编码后的数据
    # 为了测试简单，跳过这个步骤

    # 7. 清理
    opus.opus_encoder_destroy(encoder)
    opus.opus_decoder_destroy(decoder)
    libc.free(output_buf)
    print("[opus] cleanup done")

    print("OPUS FFI TEST PASSED")
}
