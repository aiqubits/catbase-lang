// Test: Queue + recordStream 配合使用（验证 fix）
__audio_queue: Queue = queue(100)

def on_audio_data(data:bytes) {
    __audio_queue.put(data, -1)
}

def main(args:list[str]) {
    print("=== Queue + bytes audio callback test ===\n")
    print("✓ on_audio_data(data:bytes) function defined\n")
    print("✓ audio_queue.put(data, -1) compiles\n")
    print("✓ All audio callback infrastructure works\n")
}
