// 真正的 bytes 类型测试
// 验证：智能分配、str<->bytes 转换、pointer_of 智能分派

def main(args: list[str]) {
    print("=== Test 1: bytes_alloc 智能分配（栈/池）===\n")
    b1: bytes = bytes_alloc(64)        # 小数据，应该用静态池
    print("allocated 64 bytes (small, should use pool)\n")

    b2: bytes = bytes_alloc(1024)      # 中等数据
    print("allocated 1024 bytes\n")

    b3: bytes = bytes_alloc(100000)    # 大数据，应该用堆
    print("allocated 100000 bytes (large, should use heap)\n")

    # 写入数据
    b1[0] = byte(72)                   # 'H'
    b1[1] = byte(101)                  # 'e'
    b1[2] = byte(108)                  # 'l'
    b1[3] = byte(108)                  # 'l'
    b1[4] = byte(111)                  # 'o'
    print("wrote 'Hello' to b1\n")
    print("b1[0] = ", b1[0], "\n")
    print("b1[4] = ", b1[4], "\n")

    print("\n=== Test 2: bytes <-> str 互转 ===\n")

    # str → bytes
    s1: str = "hello world"
    b4: bytes = bytes(s1)
    print("converted str 'hello world' to bytes\n")
    print("b4[0] = ", b4[0], "\n")
    print("b4[6] = ", b4[6], "\n")

    # bytes → str
    s2: str = str(b4)
    print("converted bytes back to str: ", s2, "\n")

    # 验证 s2 == "hello world"
    if s2 == "hello world" {
        print("round-trip conversion works\n")
    } else {
        print("ERROR: round-trip failed\n")
    }

    # None 转换
    b5: bytes = bytes(None)
    print("bytes(None) created empty bytes\n")
    bytes_free(b5)

    s3: str = str(None)
    print("str(None) = '", s3, "'\n")

    print("\n=== Test 3: pointer_of 智能分派 ===\n")

    # bytes 类型的 pointer_of → 数据指针
    ptr1: Pointer = pointer_of(b1)
    if !ptr1.is_null() {
        print("pointer_of(bytes) returned non-null pointer\n")
        # 通过 Pointer 写入第一个字节
        ptr1.set(byte, 90)   # 'Z'
        print("wrote 90 to first byte via Pointer\n")
        print("b1[0] after pointer set = ", b1[0], "\n")
    }

    # int 类型的 pointer_of → 变量地址
    n1: int = 42
    ptr2: Pointer = pointer_of(n1)
    if !ptr2.is_null() {
        v: int = ptr2.get(int)
        print("pointer_of(int) value = ", v, "\n")
        ptr2.set(int, 100)
        print("after set, n1 = ", n1, "\n")
    }

    print("\n=== Test 4: 内存释放（bytes_free）===\n")
    bytes_free(b1)
    bytes_free(b2)
    bytes_free(b3)
    bytes_free(b4)
    print("all bytes freed\n")

    print("\n=== All tests passed ===\n")
}
